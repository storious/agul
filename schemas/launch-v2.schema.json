{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agul.dev/schemas/launch-v2.schema.json",
  "title": "Agul launch v2",
  "type": "object",
  "properties": {
    "format": {
      "const": "agul/launch/v2"
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
