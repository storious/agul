{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agul.dev/schemas/plugin-v2-event.schema.json",
  "title": "Agul Plugin v2 NDJSON event",
  "oneOf": [
    {"$ref": "#/$defs/progress"},
    {"$ref": "#/$defs/session"},
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/failure"}
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["call_id", "seq"],
      "properties": {
        "call_id": {"type": "string", "minLength": 1},
        "seq": {"type": "integer", "minimum": 1}
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "call_id", "seq", "stage", "preview"],
      "properties": {
        "type": {"const": "progress"},
        "call_id": {"type": "string", "minLength": 1},
        "seq": {"type": "integer", "minimum": 1},
        "task_id": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "preview": {"type": "string", "minLength": 1}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "call_id",
        "seq",
        "relation",
        "session_id",
        "delegation_id",
        "task_id"
      ],
      "properties": {
        "type": {"const": "session"},
        "call_id": {"type": "string", "minLength": 1},
        "seq": {"type": "integer", "minimum": 1},
        "relation": {"const": "delegated"},
        "session_id": {"type": "string", "minLength": 1},
        "delegation_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "call_id", "seq", "ok", "content"],
      "properties": {
        "type": {"const": "result"},
        "call_id": {"type": "string", "minLength": 1},
        "seq": {"type": "integer", "minimum": 1},
        "ok": {"const": true},
        "content": {"not": {"type": "null"}}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "call_id", "seq", "ok", "error"],
      "properties": {
        "type": {"const": "result"},
        "call_id": {"type": "string", "minLength": 1},
        "seq": {"type": "integer", "minimum": 1},
        "ok": {"const": false},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "stage": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "retryable": {"type": "boolean"}
          }
        }
      }
    }
  }
}
