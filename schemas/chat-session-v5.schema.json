{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agul.dev/schemas/chat-session-v5.schema.json",
  "title": "Agul chat session v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "workspace",
    "model",
    "engine",
    "upstream_thread_id",
    "source",
    "status",
    "owner_pid",
    "attribution",
    "related_sessions",
    "handoff",
    "created_at",
    "updated_at",
    "summarized_turns",
    "summary",
    "turns",
    "native_config",
    "native_history",
    "pending_turn",
    "usage",
    "trace_seq"
  ],
  "properties": {
    "schema": { "const": "agul/chat-session/v5" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "workspace": { "type": "string" },
    "model": { "type": "string" },
    "engine": { "enum": ["native", "codex"] },
    "upstream_thread_id": { "$ref": "#/$defs/nullableString" },
    "source": { "enum": ["chat", "ari"] },
    "status": {
      "enum": ["active", "completed", "failed", "cancelled", "interrupted"]
    },
    "owner_pid": { "type": "integer", "minimum": 0 },
    "attribution": { "$ref": "#/$defs/attribution" },
    "related_sessions": {
      "type": "array",
      "items": { "$ref": "#/$defs/relatedSession" }
    },
    "handoff": {},
    "created_at": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "integer", "minimum": 0 },
    "summarized_turns": { "type": "integer", "minimum": 0 },
    "summary": { "type": ["string", "null"] },
    "turns": {
      "type": "array",
      "items": { "$ref": "#/$defs/turn" }
    },
    "native_config": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/nativeConfig" }
      ]
    },
    "native_history": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/providerMessage" }
        }
      ]
    },
    "pending_turn": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/pendingTurn" }
      ]
    },
    "usage": {
      "type": "array",
      "items": { "$ref": "#/$defs/usageEntry" }
    },
    "trace_seq": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_session_id",
        "delegation_id",
        "task_id",
        "specialist_id",
        "pool_id"
      ],
      "properties": {
        "parent_session_id": { "$ref": "#/$defs/nullableString" },
        "delegation_id": { "$ref": "#/$defs/nullableString" },
        "task_id": { "$ref": "#/$defs/nullableString" },
        "specialist_id": { "$ref": "#/$defs/nullableString" },
        "pool_id": { "$ref": "#/$defs/nullableString" }
      }
    },
    "relatedSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "session_id", "delegation_id", "task_id"],
      "properties": {
        "relation": { "type": "string" },
        "session_id": { "type": "string" },
        "delegation_id": { "$ref": "#/$defs/nullableString" },
        "task_id": { "$ref": "#/$defs/nullableString" }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "assistant"],
      "properties": {
        "user": { "type": "string" },
        "assistant": { "type": "string" }
      }
    },
    "nativeConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "base_url", "api_key_env", "reasoning_effort"],
      "properties": {
        "preset": {
          "type": ["string", "null"],
          "enum": ["deepseek", "glm", "glm-coding", null]
        },
        "provider": {
          "type": ["string", "null"],
          "enum": ["deepseek", "glm", null]
        },
        "base_url": { "type": "string", "minLength": 1 },
        "api_key_env": { "$ref": "#/$defs/nullableString" },
        "reasoning_effort": { "$ref": "#/$defs/nullableString" }
      }
    },
    "providerMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content", "reasoning", "tool_call_id", "tool_calls"],
      "properties": {
        "role": { "enum": ["system", "user", "assistant", "tool"] },
        "content": { "type": ["string", "null"] },
        "reasoning": { "type": ["string", "null"] },
        "tool_call_id": { "type": ["string", "null"] },
        "tool_calls": {
          "type": "array",
          "items": { "$ref": "#/$defs/providerToolCall" }
        }
      }
    },
    "providerToolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "arguments"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "arguments": {}
      }
    },
    "pendingTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible_user", "model_input"],
      "properties": {
        "visible_user": { "type": "string" },
        "model_input": { "type": "string" }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "femto_units"],
      "properties": {
        "currency": { "type": "string", "minLength": 1 },
        "femto_units": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "rates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cache_hit_input_nanos_per_million",
        "cache_miss_input_nanos_per_million",
        "output_nanos_per_million"
      ],
      "properties": {
        "cache_hit_input_nanos_per_million": { "type": "integer", "minimum": 0 },
        "cache_miss_input_nanos_per_million": { "type": "integer", "minimum": 0 },
        "output_nanos_per_million": { "type": "integer", "minimum": 0 }
      }
    },
    "priceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "catalog_version",
        "catalog_source",
        "source_checked_at",
        "review_after",
        "card_id",
        "band_id",
        "currency",
        "effective_from",
        "effective_until",
        "rates"
      ],
      "properties": {
        "catalog_id": { "type": "string" },
        "catalog_version": { "type": "string" },
        "catalog_source": { "type": "string" },
        "source_checked_at": { "type": "integer", "minimum": 0 },
        "review_after": { "type": ["integer", "null"], "minimum": 0 },
        "card_id": { "type": "string" },
        "band_id": { "type": "string" },
        "currency": { "type": "string" },
        "effective_from": { "type": "integer", "minimum": 0 },
        "effective_until": { "type": ["integer", "null"], "minimum": 0 },
        "rates": { "$ref": "#/$defs/rates" }
      }
    },
    "usageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "provider",
        "origin",
        "response_id",
        "observed_at_unix_seconds",
        "observation_time_source",
        "reported_model",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cache_hit_input_tokens",
        "cache_miss_input_tokens",
        "reasoning_tokens",
        "cost",
        "price_ref",
        "stale",
        "assumptions",
        "unpriced_reason"
      ],
      "properties": {
        "purpose": { "enum": ["chat", "compaction"] },
        "provider": { "type": "string" },
        "origin": { "type": "string" },
        "response_id": { "$ref": "#/$defs/nullableString" },
        "observed_at_unix_seconds": { "type": "integer", "minimum": 0 },
        "observation_time_source": { "enum": ["provider", "host"] },
        "reported_model": { "type": "string" },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_hit_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_miss_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cost": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/money" }
          ]
        },
        "price_ref": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/priceReference" }
          ]
        },
        "stale": { "type": "boolean" },
        "assumptions": {
          "type": "array",
          "items": { "const": "all_input_cache_miss" }
        },
        "unpriced_reason": {
          "type": ["string", "null"],
          "enum": [
            "price_catalog_missing",
            "subscription_quota",
            "usage_missing",
            "no_matching_price_card",
            "ambiguous_price_card",
            "invalid_usage",
            "cost_overflow",
            null
          ]
        }
      }
    }
  }
}
