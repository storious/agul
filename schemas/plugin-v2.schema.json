{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agul.dev/schemas/plugin-v2.schema.json",
  "title": "Agul Plugin v2 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "name", "version", "command"],
  "properties": {
    "format": {"const": "agul/plugin/v2"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "prefixItems": [{"type": "string", "minLength": 1}]
    },
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/v[0-9]+$"
      }
    },
    "commands": {
      "type": "array",
      "items": {"$ref": "#/$defs/namedCommand"}
    },
    "tools": {
      "type": "array",
      "items": {"$ref": "#/$defs/tool"}
    }
  },
  "anyOf": [
    {
      "required": ["commands"],
      "properties": {"commands": {"minItems": 1}}
    },
    {
      "required": ["tools"],
      "properties": {"tools": {"minItems": 1}}
    }
  ],
  "$defs": {
    "wireName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "namedCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {"$ref": "#/$defs/wireName"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "parameters"],
      "properties": {
        "name": {"$ref": "#/$defs/wireName"},
        "description": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"}
      }
    }
  }
}
