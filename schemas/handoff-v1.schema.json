{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agul.dev/schemas/handoff-v1.schema.json",
  "title": "Agul specialist handoff v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "agul/handoff/v1"
    },
    "status": {
      "enum": ["completed", "blocked", "failed"]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array"
    },
    "changes": {
      "type": "array"
    },
    "verification": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    },
    "next_steps": {
      "type": "array"
    }
  },
  "required": ["format", "status", "summary"],
  "additionalProperties": true
}
